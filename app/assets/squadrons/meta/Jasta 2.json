  "history": {
    "summary": "One of the best-known German Luftstreitkräfte squadrons in World War I, founded by the great aerial tactician Oswald Boelcke. It was the incubator for several notable aviation careers and the birthplace of modern fighter aviation tactics.",
    "formation": {
      "date": "1916-08-10",
      "location": "Bertincourt, France",
      "firstCommander": "Oswald Boelcke",
      "context": "Formed from scratch with no parent unit, as part of a reorganization of the German air force (Luftstreitkräfte), inspired by Boelcke himself."
    },
    "notableEvents": [
      {
        "date": "1916-09-17",
        "description": "First combat mission. Intercepted a British raid, resulting in the first victories for Manfred von Richthofen and Erwin Böhme."
      },
      {
        "date": "1916-10-28",
        "description": "Commanding Officer Oswald Boelcke was killed in a mid-air collision during a dogfight."
      },
      {
        "date": "1917-02-01",
        "description": "The unit achieved its 100th aerial victory."
      },
      {
        "date": "1918-02-01",
        "description": "Became part of the new Royal Prussian Jagdgeschwader III, under Bruno Loerzer."
      }
    ],
